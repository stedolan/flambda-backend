  (enabled_if (<> "%{context_name}" main))
  (deps (source_tree .))
  (action
   (with-stdout-to
    "%{target}"
    (run
     "%{project_root}/ocamltest/ocamltest.native"
     -no-ocamlsrcdir
     -dune
     -list-tests
     ../../tests/typing-external))))
 (rule
  (target rules.dune)
  (enabled_if (= "%{context_name}" main))
  (action (write-file "%{target}" ""))))
