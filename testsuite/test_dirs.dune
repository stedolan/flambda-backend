 (copy_files (only_sources true) (files "../../tests/weak-ephe-final/*"))
 (dynamic_include ../../tests/weak-ephe-final/rules.dune))

(subdir
 tests/win-unicode
 (rule
  (target rules.dune)
  (enabled_if (<> "%{context_name}" main))
  (deps (source_tree .))
  (action
   (with-stdout-to
    "%{target}"
    (run
     "%{project_root}/ocamltest/ocamltest.native"
     -no-ocamlsrcdir
     -dune
     -list-tests
     ../../tests/win-unicode))))
 (rule
  (target rules.dune)
  (enabled_if (= "%{context_name}" main))
  (action (write-file "%{target}" ""))))
(subdir
 ./run/win-unicode
 (copy_files (only_sources true) (files "../../tests/win-unicode/*"))
 (dynamic_include ../../tests/win-unicode/rules.dune))

