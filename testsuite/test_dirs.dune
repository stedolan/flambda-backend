(subdir
 tests/afl-instrumentation
 (rule
  (target rules.dune)
  (enabled_if (<> "%{context_name}" main))
  (deps (source_tree .))
  (action
   (with-stdout-to
    "%{target}"
    (run
     "%{project_root}/ocamltest/ocamltest.native"
     -no-ocamlsrcdir
     -dune
     -list-tests
     ../../tests/afl-instrumentation))))
 (rule
  (target rules.dune)
  (enabled_if (= "%{context_name}" main))
  (action (write-file "%{target}" ""))))
(subdir
 ./run/afl-instrumentation
 (copy_files (only_sources true) (files "../../tests/afl-instrumentation/*"))
 (dynamic_include ../../tests/afl-instrumentation/rules.dune))

