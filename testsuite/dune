(rule
  (deps (source_tree tests/))
  (action
    (with-stdout-to test_dirs.dune.gen
      (run %{project_root}/ocamltest/ocamltest.native -no-ocamlsrcdir -dune -find-test-dirs tests))))

(rule
  (alias gen_test_dirs)
  (action (diff test_dirs.dune test_dirs.dune.gen)))

(include test_dirs.dune)